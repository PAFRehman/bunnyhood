# Public origin used only on the server. No trailing slash.
APP_URL=https://www.bunnyhood.xyz

# Managed PostgreSQL connection string. Use a pooled Neon/Vercel connection URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# OAuth 2.0 client values from a newly rotated X Developer App.
X_CLIENT_ID=REPLACE_WITH_NEW_X_CLIENT_ID
X_CLIENT_SECRET=REPLACE_WITH_NEW_X_CLIENT_SECRET
X_REDIRECT_URI=https://www.bunnyhood.xyz/api/spin/auth/x/callback

# Generate these with: node scripts/generate-secrets.mjs
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
CODE_PEPPER=REPLACE_WITH_PRIVATE_RANDOM_VALUE
PRIZE_RANDOM_SECRET=REPLACE_WITH_PRIVATE_RANDOM_VALUE
RATE_LIMIT_SECRET=REPLACE_WITH_PRIVATE_RANDOM_VALUE
ADMIN_SESSION_SECRET=REPLACE_WITH_PRIVATE_RANDOM_VALUE
CRON_SECRET=REPLACE_WITH_PRIVATE_RANDOM_VALUE

# Generate with: node scripts/hash-admin-password.mjs "YOUR-STRONG-ADMIN-PASSWORD"
ADMIN_PASSWORD_HASH=REPLACE_WITH_SCRYPT_HASH

# Rabbit Hole stays behind the existing admin cookie until this is explicitly
# changed to true. Metadata and SVG art remain public so wallets can render SBTs.
RABBIT_HOLE_PUBLIC=false
RABBIT_HOLE_NETWORK=testnet
RABBIT_HOLE_TESTNET_CONTRACT_ADDRESS=REPLACE_WITH_TESTNET_SBT_ADDRESS
RABBIT_HOLE_MAINNET_CONTRACT_ADDRESS=REPLACE_WITH_MAINNET_SBT_ADDRESS

# Gas-sponsored SBT minter. Store only in Vercel encrypted environment values.
# Never prefix this with NEXT_PUBLIC_ and never commit a real key.
RABBIT_HOLE_MINTER_PRIVATE_KEY=0xREPLACE_WITH_64_HEX_CHARACTERS

# Used only by scripts/deploy-sbt.mjs. A multisig is recommended on mainnet.
RABBIT_HOLE_OWNER_ADDRESS=REPLACE_WITH_OWNER_OR_MULTISIG_ADDRESS

# Use private provider endpoints in production. These values stay on the server
# and must never use a NEXT_PUBLIC_ prefix.
ROBINHOOD_MAINNET_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/REPLACE_WITH_KEY
ROBINHOOD_TESTNET_RPC_URL=https://robinhood-testnet.g.alchemy.com/v2/REPLACE_WITH_KEY

# Neon is the only source of truth. Admin Excel exports are generated directly
# from DATABASE_URL and require no Google Sheet or webhook secret.
